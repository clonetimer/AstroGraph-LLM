{
  "schema_version": "2.2.0",
  "policy": "sensor/status/counter plus explicitly marked onboard estimates are model inputs; truth and labels remain isolated",
  "join_keys": [
    "record_id",
    "run_id"
  ],
  "identifier_fields_are_model_features": false,
  "identifier_policy": "opaque deterministic UUIDv5 hex; scenario names exist only in labels/evidence",
  "raw_telemetry_fields": [
    "time_s",
    "sensor.eps.battery_voltage_v",
    "sensor.eps.battery_current_a",
    "sensor.eps.battery_temp_c",
    "estimate.eps.battery_soc",
    "estimate.eps.battery_internal_resistance_ohm",
    "estimate.eps.battery_capacity_wh",
    "estimate.eps.battery_soh",
    "status.eps.battery_capacity_estimate_valid",
    "counter.eps.battery_equivalent_cycle_count",
    "sensor.eps.solar_array_voltage_v",
    "sensor.eps.solar_array_current_a",
    "status.eps.solar_regulator_code",
    "estimate.eps.solar_array_power_w",
    "sensor.thermal.payload_temp_c",
    "sensor.thermal.radiator_temp_c",
    "status.thermal.heater_on",
    "status.thermal.control_mode_code",
    "sensor.adcs.gyro_rate_rad_s_x",
    "sensor.adcs.gyro_rate_rad_s_y",
    "sensor.adcs.gyro_rate_rad_s_z",
    "sensor.adcs.rw.speed_rad_s_0",
    "sensor.adcs.rw.speed_rad_s_1",
    "sensor.adcs.rw.speed_rad_s_2",
    "sensor.adcs.rw.motor_current_a_0",
    "sensor.adcs.rw.motor_current_a_1",
    "sensor.adcs.rw.motor_current_a_2",
    "sensor.adcs.rw.winding_temp_c_0",
    "sensor.adcs.rw.winding_temp_c_1",
    "sensor.adcs.rw.winding_temp_c_2",
    "status.adcs.rw.available_0",
    "status.adcs.rw.available_1",
    "status.adcs.rw.available_2",
    "status.adcs.rw.driver_code_0",
    "status.adcs.rw.driver_code_1",
    "status.adcs.rw.driver_code_2",
    "adcs.rw.command_torque_nm_0",
    "adcs.rw.command_torque_nm_1",
    "adcs.rw.command_torque_nm_2",
    "estimate.adcs.rw.actual_torque_nm_0",
    "estimate.adcs.rw.actual_torque_nm_1",
    "estimate.adcs.rw.actual_torque_nm_2",
    "estimate.adcs.rw.friction_torque_nm_0",
    "estimate.adcs.rw.friction_torque_nm_1",
    "estimate.adcs.rw.friction_torque_nm_2",
    "payload.active",
    "comm.downlink_rate_bps",
    "comm.downlinked_bits",
    "status.comm.transmitter_on",
    "status.comm.transmitter_command_on",
    "sensor.comm.pa_current_a",
    "sensor.comm.rf_output_power_w",
    "counter.comm.packet_error_count",
    "counter.comm.packet_loss_count",
    "estimate.comm.packet_error_rate",
    "estimate.comm.rf_power_margin_db",
    "data.storage_bits",
    "status.eps.solar_array_available_strings",
    "status.thermal.heater_command_on",
    "sensor.thermal.heater_current_a",
    "status.adcs.star_tracker_valid",
    "status.adcs.star_tracker_locked",
    "sensor.adcs.star_tracker_data_age_s",
    "status.adcs.sensor_fusion_mode_code",
    "estimate.adcs.pointing_error_deg",
    "data.accepted_write_bps",
    "status.data.storage_write_available"
  ],
  "multirate_streams": {
    "adcs": {
      "sample_period_s": 1.0,
      "fields": [
        "time_s",
        "sensor.adcs.gyro_rate_rad_s_x",
        "sensor.adcs.gyro_rate_rad_s_y",
        "sensor.adcs.gyro_rate_rad_s_z",
        "sensor.adcs.rw.speed_rad_s_0",
        "sensor.adcs.rw.speed_rad_s_1",
        "sensor.adcs.rw.speed_rad_s_2",
        "sensor.adcs.rw.motor_current_a_0",
        "sensor.adcs.rw.motor_current_a_1",
        "sensor.adcs.rw.motor_current_a_2",
        "sensor.adcs.rw.winding_temp_c_0",
        "sensor.adcs.rw.winding_temp_c_1",
        "sensor.adcs.rw.winding_temp_c_2",
        "status.adcs.rw.available_0",
        "status.adcs.rw.available_1",
        "status.adcs.rw.available_2",
        "status.adcs.rw.driver_code_0",
        "status.adcs.rw.driver_code_1",
        "status.adcs.rw.driver_code_2",
        "adcs.rw.command_torque_nm_0",
        "adcs.rw.command_torque_nm_1",
        "adcs.rw.command_torque_nm_2",
        "estimate.adcs.rw.actual_torque_nm_0",
        "estimate.adcs.rw.actual_torque_nm_1",
        "estimate.adcs.rw.actual_torque_nm_2",
        "estimate.adcs.rw.friction_torque_nm_0",
        "estimate.adcs.rw.friction_torque_nm_1",
        "estimate.adcs.rw.friction_torque_nm_2",
        "status.adcs.star_tracker_valid",
        "status.adcs.star_tracker_locked",
        "sensor.adcs.star_tracker_data_age_s",
        "status.adcs.sensor_fusion_mode_code",
        "estimate.adcs.pointing_error_deg"
      ]
    },
    "eps": {
      "sample_period_s": 5.0,
      "fields": [
        "time_s",
        "sensor.eps.battery_voltage_v",
        "sensor.eps.battery_current_a",
        "sensor.eps.battery_temp_c",
        "sensor.eps.solar_array_voltage_v",
        "sensor.eps.solar_array_current_a",
        "status.eps.solar_regulator_code",
        "estimate.eps.battery_soc",
        "estimate.eps.battery_internal_resistance_ohm",
        "estimate.eps.battery_capacity_wh",
        "estimate.eps.battery_soh",
        "status.eps.battery_capacity_estimate_valid",
        "counter.eps.battery_equivalent_cycle_count",
        "estimate.eps.solar_array_power_w",
        "status.eps.solar_array_available_strings"
      ]
    },
    "comm": {
      "sample_period_s": 10.0,
      "fields": [
        "time_s",
        "payload.active",
        "comm.downlink_rate_bps",
        "comm.downlinked_bits",
        "data.storage_bits",
        "status.comm.transmitter_on",
        "sensor.comm.pa_current_a",
        "sensor.comm.rf_output_power_w",
        "counter.comm.packet_error_count",
        "status.comm.transmitter_command_on",
        "counter.comm.packet_loss_count",
        "estimate.comm.packet_error_rate",
        "estimate.comm.rf_power_margin_db",
        "data.accepted_write_bps",
        "status.data.storage_write_available"
      ]
    },
    "thermal": {
      "sample_period_s": 30.0,
      "fields": [
        "time_s",
        "sensor.thermal.payload_temp_c",
        "sensor.thermal.radiator_temp_c",
        "status.thermal.heater_on",
        "status.thermal.control_mode_code",
        "status.thermal.heater_command_on",
        "sensor.thermal.heater_current_a"
      ]
    }
  },
  "labels_are_model_inputs": false,
  "simulation_internal_evidence_is_model_input": false,
  "provisional_status": "synthetic spacecraft contract; not a flight telemetry ICD",
  "explicitly_excluded_examples": [
    "orbit.phase_rad",
    "orbit.eclipse_flag",
    "orbit.sun_incidence_cos",
    "adcs.pointing_error_deg",
    "adcs.pointing_quality",
    "adcs.power_w",
    "eps.solar_efficiency_scale",
    "eps.solar_array_power_w",
    "eps.load_power_w",
    "eps.net_power_w",
    "eps.effective_battery_capacity_wh",
    "eps.battery_energy_wh",
    "eps.battery_soc",
    "thermal.effective_radiator_coeff_w_per_k",
    "thermal.heat_input_w",
    "event.active_effects",
    "task_id",
    "case_id",
    "mode"
  ],
  "exclusion_reason": "model state, environmental truth, derived quantity, scenario metadata, or supervised label",
  "virtual_sensor_contract": "virtual_sensor_contract.json",
  "telemetry_layer_contract": "telemetry_layer_contract.json",
  "protocol_extension": "phm_project_a_v1.2",
  "extension_source": "whole-spacecraft all-fault runtime v1.1 and D3 thermal/star fault protocols",
  "protocol_version": "1.2"
}
