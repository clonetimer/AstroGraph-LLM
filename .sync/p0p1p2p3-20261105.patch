+name: External analysis observability (source)
+on:
+  push:
+    branches: [feat/pilotdeck-observability]
+    paths:
+      - 'portable/**'
+      - 'src/astrograph/**'
+      - 'tests/test_external_execution_observability.py'
+      - 'tests/test_p2_context_platform.py'
+      - 'tests/ui/test_external_diagnosis_ui_input.py'
+      - 'tests/ui/test_execution_views_integration.py'
+      - '.github/workflows/observability-source.yml'
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  portable:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-22.04
+            python: '3.8'
+          - os: ubuntu-22.04
+            python: '3.11'
+          - os: windows-2022
+            python: '3.8'
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python }}
+      - name: Install development-only test dependencies
+        run: python -m pip install pydantic==2.10.6 pydantic-core==2.27.2 annotated-types==0.7.0 typing-extensions==4.13.2 eval-type-backport==0.2.2 pypdf==5.9.0 reportlab==4.4.3 certifi==2026.10.23
+      - name: Test shared portable source (not native Win7 acceptance)
+        run: python -B -m unittest discover -s portable -p "test*.py" -v
+  platform:
+    runs-on: ubuntu-22.04
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - run: python -m pip install -e '.[platform,test]'
+      - name: Platform recording, authorization and both report surfaces
+        run: python -m pytest -q --astrograph-test-profile source-only tests/test_external_execution_observability.py tests/test_external_diagnosis_analysis.py tests/test_external_diagnosis_platform.py tests/test_external_diagnosis_conversation.py tests/test_external_llm_transport_updates.py tests/ui/test_execution_views_integration.py tests/ui/test_external_diagnosis_ui_output.py tests/ui/test_external_diagnosis_ui_input.py tests/test_p2_context_platform.py
