{
  "$defs": {
    "DataAcceptanceLevel": {
      "enum": [
        "ACCEPTANCE_VALID",
        "EFFECT_VALID_RESEARCH_ONLY",
        "INVALID",
        "NOT_APPLICABLE"
      ],
      "title": "DataAcceptanceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "astrograph-material-passport.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "title": "Artifact Type",
      "type": "string"
    },
    "logical_path": {
      "minLength": 1,
      "title": "Logical Path",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "contract_id": {
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "generated_by": {
      "minLength": 1,
      "title": "Generated By",
      "type": "string"
    },
    "source_artifact_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Source Artifact Hashes",
      "type": "array"
    },
    "data_acceptance_level": {
      "$ref": "#/$defs/DataAcceptanceLevel",
      "default": "NOT_APPLICABLE"
    },
    "allowed_uses": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Uses",
      "type": "array"
    },
    "claims": {
      "items": {
        "type": "string"
      },
      "title": "Claims",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_type",
    "logical_path",
    "sha256",
    "contract_id",
    "contract_sha256",
    "candidate_id",
    "generated_by",
    "allowed_uses"
  ],
  "title": "MaterialPassport",
  "type": "object"
}
