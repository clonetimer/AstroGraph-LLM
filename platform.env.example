# AstroGraph automated diagnosis platform - optional knowledge services.
# Copy values into your shell environment; this file contains no secrets.

# Persistent platform jobs (default: ~/.astrograph/platform)
# ASTROGRAPH_PLATFORM_ROOT=/absolute/path/to/astrograph-platform-runs

# Background diagnosis executor. `auto` uses THREAD in local/desktop auth mode and
# PROCESS in non-local/server auth mode. Use `process` explicitly only when separate
# worker isolation is desired.
ASTROGRAPH_PLATFORM_JOB_EXECUTOR=auto

# Local document retrieval is always available for TXT/MD/DOCX/PDF.
ASTROGRAPH_PLATFORM_LOCAL_TOP_K=5

# PaperSeek. Prefer an already running HTTP service when available.
# ASTROGRAPH_PLATFORM_PAPERSEEK_URL=http://127.0.0.1:8000
# Or point directly at the supplied PaperSeek source tree; AstroGraph will invoke
# `python -m paperseek.cli search ... --output json` in a managed subprocess.
# ASTROGRAPH_PLATFORM_PAPERSEEK_SOURCE_ROOT=/absolute/path/to/paperseek
ASTROGRAPH_PLATFORM_PAPERSEEK_SOURCE=openalex
ASTROGRAPH_PLATFORM_PAPERSEEK_TOP_K=5
ASTROGRAPH_PLATFORM_PAPERSEEK_CLI_TIMEOUT_S=180

# PaperSeek itself needs its own literature-source/LLM configuration. For example:
# OPENALEX_API_KEY=...
# LLM_PROVIDER=ollama
# LLM_API_TYPE=openai_chat
# LLM_MODEL=...
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=...   # not needed by some local providers

# OpenAI-compatible explanation model endpoint (Qwen/DeepSeek/vLLM/LM Studio/Ollama gateway).
# LM Studio commonly uses its local OpenAI-compatible server on 127.0.0.1:1234; use the actual port shown by your server.
# ASTROGRAPH_PLATFORM_LLM_BASE_URL=http://127.0.0.1:1234/v1
# ASTROGRAPH_PLATFORM_LLM_MODEL=Qwen2.5-3B-Instruct
ASTROGRAPH_PLATFORM_LLM_PROVIDER=local-openai-compatible
ASTROGRAPH_PLATFORM_LLM_TIMEOUT_S=120
# The same process-scoped values can be set from /platform -> 系统与服务. UI secrets are write-only and are not persisted across service restart.
# Put the key only in the environment, never in uploaded material or archived configuration.
# ASTROGRAPH_LLM_API_KEY=your-key-or-local-placeholder

# Anything2Ontology: disabled unless explicitly enabled by the administrator.
ASTROGRAPH_PLATFORM_A2O_ENABLED=0
# Either install the four console commands, or point at the supplied repository.
# ASTROGRAPH_PLATFORM_A2O_SOURCE_ROOT=/absolute/path/to/anything2ontology
ASTROGRAPH_PLATFORM_A2O_LANGUAGE=zh
ASTROGRAPH_PLATFORM_A2O_TIMEOUT_S=900

# When 1, a configured PaperSeek/A2O/LLM failure fails the knowledge stage instead of returning PARTIAL.
ASTROGRAPH_PLATFORM_REQUIRE_KNOWLEDGE_SERVICES=0

# Optional isolated Anything2Ontology environment (administrator configuration)
# ASTROGRAPH_PLATFORM_A2O_PYTHON=/absolute/path/to/a2o-env/bin/python

# Optional checked, loopback source-code adapter. See docs/STABLE_FOUNDATION_POST42.md.
# ASTROGRAPH_PLATFORM_SOURCE_TOOL_URL=http://127.0.0.1:18083
# ASTROGRAPH_PLATFORM_SOURCE_TOOL_ADAPTER_SHA256=ee1e4b0fbc796eb7578bcd509a4706cab50ceb3c1a494b03ca6d1f29b40b96ed

# Optional trusted Agent-tool plugin directory. Disabled by default.
# IMPORTANT: files in this directory are administrator-reviewed Python code, not untrusted uploads.
# ASTROGRAPH_AGENT_TOOL_PLUGINS_ENABLED=1
# ASTROGRAPH_AGENT_TOOL_PLUGIN_DIR=/absolute/path/to/reviewed-agent-tools
# Hot reload affects future task registry snapshots only; running sealed registries are never mutated.

# Material-first evidence fusion (diagnosis result + log reports + references).
# BM25 + character n-gram RAG works without external configuration.
# Optional local embeddings; only pre-downloaded, administrator-approved model directories.
# ASTROGRAPH_MATERIAL_EMBEDDING_MODEL=/opt/models/approved-local-sentence-transformer

# Optional version-bound, READ-ONLY KG references. Defaults to NOT_CONFIGURED.
# ASTROGRAPH_MATERIAL_KG_BINDING_JSON=/opt/astrograph/kg/approved-binding.json
# ASTROGRAPH_MATERIAL_KG_MODE=csv  # csv | neo4j | auto
# ASTROGRAPH_NEO4J_READ_PASSWORD=do-not-put-secrets-in-this-file

# Independent, host-owned material knowledge approval. Both endpoints disabled by default.
# Explicit equipment_scope must be provided in input and at approval for historic reuse.
# ASTROGRAPH_MATERIAL_REVIEWERS=independent-expert-one,independent-expert-two
# ASTROGRAPH_MATERIAL_REVIEWER=independent-expert-one
# ASTROGRAPH_MATERIAL_REVIEW_TOKEN=generate-a-long-random-value-outside-source-control
# Keep admin token on the trusted server only; never embed it in browser resources.

# Material graph construction: disabled until an administrator supplies a model.
# Input reference material may contain confidential engineering details. Prefer an
# approved local LLM endpoint and audit outbound traffic before enabling extraction.
# ASTROGRAPH_MATERIAL_GRAPH_BUILD_ENABLED=1
# ASTROGRAPH_MATERIAL_GRAPH_LLM_BASE_URL=http://127.0.0.1:1234/v1
# ASTROGRAPH_MATERIAL_GRAPH_LLM_MODEL=approved-local-structured-extractor
# ASTROGRAPH_MATERIAL_GRAPH_MAX_CHUNKS=12
# ASTROGRAPH_MATERIAL_GRAPH_TIMEOUT_S=60

# Optional signed material graph release and host-admin Neo4j import. No writes by
# default, and the database MUST be distinct from the existing Active KG database.
# ASTROGRAPH_MATERIAL_GRAPH_RELEASE_SIGNING_KEY=set-in-secret-manager-min-32-chars
# ASTROGRAPH_MATERIAL_GRAPH_NEO4J_WRITE_ENABLED=1
# ASTROGRAPH_MATERIAL_GRAPH_NEO4J_DATABASE=astrograph_material_approved
# ASTROGRAPH_MATERIAL_GRAPH_NEO4J_URI=bolt://127.0.0.1:7687
# ASTROGRAPH_MATERIAL_GRAPH_NEO4J_USER=restricted_material_writer
# ASTROGRAPH_MATERIAL_GRAPH_NEO4J_PASSWORD=inject-via-secrets-not-checked-in

# Knowledge engineering Web console extension (credentials must come from secrets manager)
# ASTROGRAPH_MATERIAL_GRAPH_PUBLISHERS=knowledge_expert
# ASTROGRAPH_MATERIAL_REVIEW_TRUSTED_HTTPS_PROXY=1
# Remote reviewer login is allowed only behind a trusted HTTPS ingress.
# Browser sessions are single-process; use enterprise IAM/OIDC for production multi-user.

# Advanced material evidence retrieval and optional multimodal candidates.
# Reviewed community search is enabled automatically when a same-scope approved KG
# snapshot exists; its summaries are grounded in exact reviewed edge quotes.
# Optional use of an administrator-configured, local graph extraction model to
# SELECT exact already-reviewed quotes (no free-form new claims):
# ASTROGRAPH_MATERIAL_COMMUNITY_LLM_ENABLED=1
# Optional approved, local Sentence Transformers model; never downloads models:
# ASTROGRAPH_MATERIAL_EMBEDDING_MODEL=/opt/models/local-approved-embedding
# ASTROGRAPH_MATERIAL_VECTOR_CACHE_DB=/srv/astrograph-private/material_embeddings.sqlite3
# Qdrant ANN is an ALTERNATIVE to SQLite cache; separately deploy/authenticate it.
# ASTROGRAPH_MATERIAL_QDRANT_URL=https://qdrant.internal.example:6333
# ASTROGRAPH_MATERIAL_QDRANT_COLLECTION=astrograph_material_embeddings
# ASTROGRAPH_MATERIAL_QDRANT_API_KEY=from-secret-manager-not-a-checked-in-value
# Offline scanned reference PDFs become unreviewed OCR candidates, NOT evidence:
# ASTROGRAPH_MATERIAL_OCR_ENGINE=tesseract  # tesseract | docling
# ASTROGRAPH_MATERIAL_OCR_LANGUAGES=chi_sim+eng
# Optional local vision candidate export uses python -m astrograph.retrieval.advanced_multimodal.
# IMPORTANT: OCR/Docling/VLM observations require independent page/figure checking.
