+from __future__ import annotations
+
+import csv
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+import pytest
+
+from sat_sim import trusted_campaign as tc
+
+
+@dataclass
+class Row:
+    battery_soc: float
+    attitude_error_deg: float
+    rate_error_norm_rad_s: float
+    thermal_temp_c: float
+
+
+def test_runtime_is_fail_closed_when_basilisk_missing(monkeypatch):
+    def missing(_name):
+        raise tc.importlib.metadata.PackageNotFoundError("bsk")
+    monkeypatch.setattr(tc.importlib.metadata, "version", missing)
+    with pytest.raises(tc.TrustedCampaignError, match="BASILISK_RUNTIME_UNAVAILABLE"):
+        tc.verify_basilisk_runtime()
+
+
+def test_public_trace_leak_scans_labels_and_truth_proxies(tmp_path: Path):
+    path = tmp_path / "trace.csv"
+    path.write_text("time_s,label.fault_active,effect.active_ids,battery_soc\n0,0,,0.6\n", encoding="utf-8")
+    assert tc.public_trace_leaks(path) == ["effect.active_ids", "label.fault_active"]
+
+
+def test_public_trace_without_labels_is_clean(tmp_path: Path):
+    path = tmp_path / "trace.csv"
+    path.write_text("time_s,battery_soc,thermal_temp_c\n0,0.6,20\n", encoding="utf-8")
+    assert tc.public_trace_leaks(path) == []
+
+
+def test_trend_validation_requires_direction_and_threshold():
+    nominal = [Row(0.6, 1.0, 0.1, 20.0), Row(0.5, 2.0, 0.2, 21.0)]
+    effect = [Row(0.6, 1.5, 0.2, 22.0), Row(0.4, 3.0, 0.4, 25.0)]
+    result = tc._validate_trend(nominal, effect, {
+        "field": "thermal_temp_c", "aggregate": "final", "direction": "increase",
+        "absolute_delta_min": 1.0, "relative_delta_min": 0.01,
+    })
+    assert result["status"] == "PASS"
+    failed = tc._validate_trend(nominal, effect, {
+        "field": "thermal_temp_c", "aggregate": "final", "direction": "decrease",
+        "absolute_delta_min": 1.0, "relative_delta_min": 0.01,
+    })
+    assert failed["status"] == "FAIL"
+
+
+def _summary(**overrides):
+    payload = {
+        "status": "PASS",
+        "execution_status": "PASS",
+        "physics_status": "PASS_SINGLE_RUN_LIMITED",
+        "data_conservation_status": "PASS",
+        "energy_conservation_status": "PASS",
+        "runtime_injection_status": "PASS",
+        "runtime_fault_triggered_count": 0,
+        "runtime_unsupported_count": 0,
+        "basilisk_simbase_used": True,
+        "execute_simulation_used": True,
+        "backend": "basilisk",
+    }
+    payload.update(overrides)
+    return payload
+
+
+def test_source_gate_distinguishes_nominal_and_effect():
+    ok, reasons = tc._source_single_run_pass(_summary(), variant="nominal")
+    assert ok and not reasons
+    ok, reasons = tc._source_single_run_pass(_summary(runtime_fault_triggered_count=1), variant="effect")
+    assert ok and not reasons
+    ok, reasons = tc._source_single_run_pass(_summary(runtime_fault_triggered_count=0), variant="effect")
+    assert not ok and "NO_RUNTIME_FAULT_TRIGGERED" in reasons
+
+
+def test_single_run_plain_physics_pass_cannot_substitute_limited_evidence():
+    ok, reasons = tc._source_single_run_pass(_summary(physics_status="PASS"), variant="nominal")
+    assert not ok
+    assert "SOURCE_SINGLE_RUN_PHYSICS_NOT_LIMITED_PASS" in reasons
+
+
+def test_campaign_config_has_twelve_runs_and_three_pairs_minimum():
+    root = Path(__file__).resolve().parents[1]
+    config = tc.TrustedCampaignConfig.from_json(root / "configs/integration/trusted_basilisk_campaign.json")
+    assert len(config.cases) == 6
+    assert len(config.cases) * 2 >= 12
+    assert len({case.scenario_id for case in config.cases}) >= 3
+
+
+def test_install_constants_are_frozen():
+    assert tc.EXPECTED_BSK_VERSION == "2.11.0"
+    assert tc.EXPECTED_LINUX_X86_64_WHEEL_SHA256 == "d51fe1ffa1b0b03dc415034b210497b28a2504428d4d8e71b481542a08c08a0a"
