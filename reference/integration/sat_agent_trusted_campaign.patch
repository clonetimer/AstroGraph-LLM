+#!/usr/bin/env python3
+"""Install the frozen Basilisk 2.11.0 wheel with hash verification."""
+from __future__ import annotations
+
+import argparse
+import importlib.metadata
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SRC = ROOT / "src"
+if str(SRC) not in sys.path:
+    sys.path.insert(0, str(SRC))
+
+from sat_sim.trusted_campaign import (
+    EXPECTED_BSK_VERSION,
+    EXPECTED_LINUX_X86_64_WHEEL,
+    EXPECTED_LINUX_X86_64_WHEEL_SHA256,
+    sha256_file,
+    verify_basilisk_runtime,
+)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--wheel", type=Path, required=True)
+    parser.add_argument("--receipt", type=Path, default=Path("third_party/basilisk_runtime_receipt.json"))
+    parser.add_argument("--target", type=Path, default=None, help="optional isolated installation directory")
+    args = parser.parse_args()
+    wheel = args.wheel.resolve()
+    if not wheel.is_file():
+        raise SystemExit(f"wheel missing: {wheel}")
+    if wheel.name != EXPECTED_LINUX_X86_64_WHEEL:
+        raise SystemExit(f"unexpected wheel filename: {wheel.name}")
+    actual = sha256_file(wheel)
+    if actual != EXPECTED_LINUX_X86_64_WHEEL_SHA256:
+        raise SystemExit(f"wheel SHA256 mismatch: {actual}")
+    command = [sys.executable, "-m", "pip", "install", "--no-deps", "--force-reinstall"]
+    if args.target is not None:
+        args.target.mkdir(parents=True, exist_ok=True)
+        command += ["--target", str(args.target.resolve())]
+    command.append(str(wheel))
+    subprocess.run(command, check=True)
+    if args.target is not None:
+        sys.path.insert(0, str(args.target.resolve()))
+    runtime = verify_basilisk_runtime()
+    receipt = {
+        "schema_version": "sat-agent-basilisk-install-receipt.v1",
+        "status": "PASS",
+        "version": importlib.metadata.version("bsk"),
+        "wheel_filename": wheel.name,
+        "wheel_sha256": actual,
+        "wheel_path": str(wheel),
+        "python_executable": sys.executable,
+        "runtime": runtime,
+    }
+    args.receipt.parent.mkdir(parents=True, exist_ok=True)
+    args.receipt.write_text(json.dumps(receipt, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(receipt, ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
