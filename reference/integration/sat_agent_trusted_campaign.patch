+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+
+def test_required_trusted_campaign_entrypoints_exist():
+    root = Path(__file__).resolve().parents[1]
+    for relative in (
+        "scripts/install_basilisk_runtime.py",
+        "scripts/run_basilisk_fault_matrix.py",
+        "scripts/generate_coupled_fault_campaign.py",
+        "scripts/export_trusted_run_evidence.py",
+    ):
+        path = root / relative
+        assert path.is_file(), relative
+        assert path.stat().st_size > 100
+
+
+def test_trusted_campaign_entrypoints_run_help_without_pythonpath():
+    root = Path(__file__).resolve().parents[1]
+    environment = dict(os.environ)
+    environment.pop("PYTHONPATH", None)
+    for relative in (
+        "scripts/install_basilisk_runtime.py",
+        "scripts/run_basilisk_fault_matrix.py",
+        "scripts/generate_coupled_fault_campaign.py",
+    ):
+        completed = subprocess.run(
+            [sys.executable, str(root / relative), "--help"],
+            cwd=root,
+            env=environment,
+            text=True,
+            capture_output=True,
+            timeout=30,
+            check=False,
+        )
+        assert completed.returncode == 0, (relative, completed.stdout, completed.stderr)
+        assert "usage:" in completed.stdout.lower()
