    "post_residual_rms_ratio": "post premodel-residual RMS divided by pre residual RMS with 1e-12 floor",
    "post_residual_mean_over_scale": "post premodel-residual mean divided by pre residual scale",
    "post_residual_slope_over_scale": "post premodel-residual unit-index linear slope divided by pre residual scale",
    "impulse_l1_concentration": "maximum absolute premodel residual divided by its full-episode L1 norm with 1e-12 floor",
    "onset_window_energy_fraction": "premodel residual squared energy within selected split plus or minus two samples divided by full squared energy",
    "lag1_autocorrelation": "finite Pearson lag-one correlation of premodel residual, otherwise zero",
    "max_periodic_autocorrelation_lag_2_20": "maximum finite absolute Pearson autocorrelation over feasible frozen lags 2 through 20, otherwise zero",
    "sign_change_fraction": "fraction of adjacent nonzero premodel residual signs that differ",
    "active_fraction_two_mad": "fraction satisfying the frozen active residual rule",
    "longest_active_run_fraction": "longest contiguous active-residual run divided by residual length",
    "state_plateau_fraction": "fraction satisfying the frozen state plateau rule",
    "state_jump_over_pre_scale": "maximum absolute state first difference divided by pre state-difference MAD with RMS and 1e-12 fallback",
    "input_residual_correlation": "maximum absolute finite Pearson correlation between post residual and each normalized physical-design column",
    "selected_change_score_log1p": "natural log of one plus selected nonnegative change score"
