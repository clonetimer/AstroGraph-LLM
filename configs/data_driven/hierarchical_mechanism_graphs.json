{
  "schema_version": "astrograph-data-driven-hierarchical-mechanism-graphs.v1",
  "graphs": {
    "adcs_v5_2_2": {
      "components": ["control_loop", "imu", "reaction_wheel", "star_tracker", "sun_sensor"],
      "subsystems": ["adcs"],
      "spacecraft": "whole_spacecraft",
      "component_to_subsystem": {
