      "title": "Source Artifact Sha256",
      "type": "string"
    },
    "source_path": {
      "minLength": 1,
      "title": "Source Path",
      "type": "string"
    },
    "source_excerpt": {
      "minLength": 1,
      "title": "Source Excerpt",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
    },
    "expected": {
      "additionalProperties": true,
      "title": "Expected",
      "type": "object"
    },
    "teacher": {
      "minLength": 1,
      "title": "Teacher",
      "type": "string"
    },
    "generation_round": {
      "minimum": 1,
