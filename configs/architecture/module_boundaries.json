  "patterns": [
    {
      "pattern_id": "source_system",
      "expression": "(?i)\\bsat[-_ ]?(?:sim|agent)(?:\\b|_)",
      "description": "Concrete Sat-Sim or Sat-Agent identity."
    },
    {
      "pattern_id": "fault_identifier",
      "expression": "(?i)\\bFAULT\\.(?:ADCS|COMM|EPS|THERMAL|PAYLOAD|UNSPECIFIED)[A-Z0-9_.-]*\\b",
      "description": "Concrete legacy fault identifier."
    },
    {
      "pattern_id": "raw_channel",
      "expression": "(?i)\\b(?:estimate|truth|effect|event|label|object)\\.(?:adcs|comm|eps|thermal|payload|degradation|fault|health|modifier|phase|synthetic|active|composite)[A-Za-z0-9_.-]*",
      "description": "Concrete source or truth field."
    },
    {
      "pattern_id": "case_identity",
      "expression": "(?i)\\b(?:case|scenario)[-_][0-9][A-Za-z0-9_-]*\\b",
      "description": "Concrete case or scenario identifier."
    },
    {
      "pattern_id": "domain_fault_alias",
      "expression": "(?i)\\b(?:rw|battery|solar_array|radiator|downlink)_(?:jam|friction|overspeed|capacity_loss|efficiency_loss|rejection_loss|loss)\\b",
      "description": "Concrete legacy domain fault alias."
    }
  ]
