        },
        "claim_boundary": {
          "default": "Declares executable positive-vote evidence-schema capability only. It does not assert that evidence is present or satisfied in a particular episode, and it is not a performance, causal, or qualification claim.",
          "title": "Claim Boundary",
          "type": "string"
        }
      },
      "required": [
