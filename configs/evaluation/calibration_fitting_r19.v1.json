  "required_partitions": [
    "CALIBRATION_FIT",
    "DEVELOPMENT_SELECTION",
    "CONFIRMATORY_EVALUATION",
    "EXTERNAL_VALIDATION"
  ],
  "required_dimensions": [
    "simulator_version",
    "mission_mode",
    "fault_severity",
    "noise_condition"
  ],
  "minimum_development_groups": 4,
  "minimum_confirmatory_groups": 8,
  "minimum_external_validation_groups": 8,
  "ece_bins": 10,
  "bootstrap_resamples": 2000,
  "bootstrap_seed": 20260918,
  "max_development_selective_risk": 0.1,
  "guardrails": {
    "max_confirmatory_nll_increase": 0.0,
    "max_confirmatory_brier_increase": 0.0,
