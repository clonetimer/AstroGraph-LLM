    "max_external_nll_increase": 0.02,
    "max_external_brier_increase": 0.02,
    "max_external_ece_increase": 0.05,
    "max_classwise_brier_increase": 0.05,
    "max_classwise_ece_increase": 0.1,
    "max_external_selective_risk_increase": 0.02,
    "max_external_coverage_decrease": 0.1
  },
  "guardrail_status": "ENGINEERING_REVIEW_FLOORS_NOT_FLIGHT_CALIBRATED",
  "selection_rule": "Calibrator parameters use CALIBRATION_FIT only. Abstention threshold uses DEVELOPMENT_SELECTION only. CONFIRMATORY_EVALUATION and EXTERNAL_VALIDATION are locked evaluation partitions and may not retune either calibrator or threshold.",
  "claim_boundary": "R19 freezes a calibration-fitting and external-validation admission protocol. Passing the engineering guardrails may create a content-bound calibration qualification receipt for review, but does not establish arbitrary-shift reliability, HIL/flight qualification, release safety, or calibrated diagnostic correctness.",
  "minimum_positive_groups_per_class": 2
}
