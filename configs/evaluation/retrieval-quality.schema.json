{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation-only source-bound retrieval judgments; not a planner input",
  "type": "object",
  "required": ["schema_version", "scope", "corpus", "queries", "top_k"],
  "properties": {
    "schema_version": {"const": "astrograph-retrieval-quality.v1"},
    "scope": {"type": "string", "minLength": 1},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 20},
    "corpus": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "queries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["query_id", "query", "relevant"], "properties": {"query_id": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1}, "relevant": {"type": "array", "items": {"type": "object", "required": ["source_sha256", "quote", "role"], "properties": {"source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "quote": {"type": "string", "minLength": 1}, "role": {"enum": ["support", "counter", "context"]}}}}}}}
  }
}
