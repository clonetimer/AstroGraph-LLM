{
  "$id": "astrograph-soft-evidence-calibration-policy.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "status",
    "entries",
    "selected_on_groups",
    "forbidden_groups",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "astrograph-soft-evidence-calibration-policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["CANDIDATE", "DEVELOPMENT_SELECTED", "FROZEN"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_definition_id", "conditions"],
        "properties": {
          "evidence_definition_id": {"type": "string", "minLength": 1},
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                                "feature_definition_id",
                                "unit",
                "transition_width",
                "observation_uncertainty",
                "reference_uncertainty",
                "threshold_uncertainty",
                "interval_z"
              ],
              "properties": {
                                "feature_definition_id": {"type": "string", "minLength": 1},
                                "unit": {"type": "string", "minLength": 1},
                "transition_width": {"type": "number", "exclusiveMinimum": 0},
                "observation_uncertainty": {"type": "number", "minimum": 0},
                "reference_uncertainty": {"type": "number", "minimum": 0},
                "threshold_uncertainty": {"type": "number", "minimum": 0},
                "interval_z": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    },
    "selected_on_groups": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "forbidden_groups": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "selection_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
